# Base URL of the FastAPI backend. Defaults to http://localhost:8000 in
# lib/api.js if this file/var is absent — only needed if your setup differs
# (e.g. running the frontend via the docker-compose `frontend` service,
# where the backend might need to be reached as http://backend:8000 for
# server-to-server calls, or a different port).
NEXT_PUBLIC_API_URL=http://localhost:8000
